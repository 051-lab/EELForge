{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".test-dist",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/domain.ts",
    "src/migrations.ts",
    "src/filename.ts",
    "src/prompt/**/*.ts",
    "src/store.ts"
  ]
}
